#!/usr/bin/env python3
"""Deterministic fake ``tines`` executable for subprocess integration tests."""

from __future__ import annotations

import json
import sys


def main() -> int:
    arguments = sys.argv[1:]
    if arguments[:2] == ["issues", "context"] and arguments[-1:] == ["--json"]:
        json.dump({"skills": []}, sys.stdout)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
