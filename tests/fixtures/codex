#!/usr/bin/env python3
"""Deterministic fake ``codex`` executable for subprocess integration tests."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


TASK_URL = "https://cloud.example/tasks/fake"


def append_record(record: dict[str, object]) -> None:
    log_path = Path(os.environ["FAKE_CODEX_LOG"])
    with log_path.open("a", encoding="utf-8") as log_file:
        json.dump(record, log_file, sort_keys=True)
        log_file.write("\n")


def next_status_call() -> int:
    state_path = Path(os.environ["FAKE_CODEX_STATE"])
    try:
        call_number = int(state_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        call_number = 0
    state_path.write_text(str(call_number + 1), encoding="utf-8")
    return call_number


def main() -> int:
    scenario = os.environ["FAKE_CODEX_SCENARIO"]
    arguments = sys.argv[1:]
    input_text = sys.stdin.read()
    record: dict[str, object] = {
        "args": arguments,
        "stdin": input_text,
        "tines_api_key_present": "TINES_API_KEY" in os.environ,
        "tines_api_url": os.environ.get("TINES_API_URL"),
    }

    return_code = 0
    stdout = ""
    stderr = ""
    if arguments[:2] == ["cloud", "exec"]:
        record["operation"] = "exec"
        if scenario == "malformed-submission":
            stdout = "submitted without a task reference\n"
        elif scenario == "submission-process-failure":
            return_code = 23
            stderr = f"simulated submission failure: {os.environ['FAKE_FAILURE_MARKER']}\n"
        else:
            stdout = f"Task URL: {TASK_URL}\n"
    elif arguments[:2] == ["cloud", "status"]:
        record["operation"] = "status"
        status_call = next_status_call()
        if scenario == "successful-submission":
            stdout = "status: READY\n"
        elif scenario == "pending-to-ready":
            stdout = f"status: {'PENDING' if status_call == 0 else 'READY'}\n"
        elif scenario == "pending-to-error":
            stdout = f"status: {'PENDING' if status_call == 0 else 'ERROR'}\n"
        elif scenario == "transient-status-failure":
            return_code = 17
            stderr = f"temporary status failure: {os.environ['FAKE_FAILURE_MARKER']}\n"
        elif scenario == "status-process-failure":
            return_code = 29
            stderr = f"simulated status failure: {os.environ['FAKE_FAILURE_MARKER']}\n"
        else:
            return_code = 64
            stderr = f"unknown fake scenario: {scenario}\n"
    else:
        record["operation"] = "unknown"
        return_code = 64
        stderr = "unexpected fake codex arguments\n"

    append_record(record)
    if stdout:
        sys.stdout.write(stdout)
    if stderr:
        sys.stderr.write(stderr)
    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
